@page
@model wt_lab5_5razor_talko.Pages.Couriers.CreateModel
@{
    ViewData["Title"] = "Добавить курьера";
    Layout = "_Layout";
}

<div class="container py-4">
    <h1 style="color: #4a3d24;">Добавить курьера</h1>
    <form method="post" class="mt-4 shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">ФИО</label>
            <input asp-for="Courier.FullName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Телефон</label>
            <input asp-for="Courier.Phone" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Транспорт</label>
            <input asp-for="Courier.Vehicle" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ссылка на фото</label>
            <input asp-for="Courier.ImageUrl" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success">Добавить</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>