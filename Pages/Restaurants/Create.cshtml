@page
@model wt_lab5_5razor_talko.Pages.Restaurants.CreateModel
@{
    ViewData["Title"] = "Добавить ресторан";
    Layout = "_Layout";
}

<div class="container py-4">
    <h1 style="color: #4a3d24;">Добавить ресторан</h1>
    <form method="post" class="mt-4 shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">Название</label>
            <input asp-for="Restaurant.Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Адрес</label>
            <input asp-for="Restaurant.Address" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Телефон</label>
            <input asp-for="Restaurant.Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ссылка на фото</label>
            <input asp-for="Restaurant.ImageUrl" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success">Добавить</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>