@page
@model wt_lab5_5razor_talko.Pages.Restaurants.DeleteModel

<div class="container mt-4">
    <div class="card shadow rounded-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Удалить ресторан</h3>
        </div>
        <div class="card-body">
            <p>Вы уверены, что хотите удалить ресторан <strong>@Model.Restaurant?.Title</strong>?</p>

            <form method="post">
                <input type="hidden" name="id" value="@Model.Restaurant?.Id" />
                <button type="submit" class="btn btn-danger">Удалить</button>
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>