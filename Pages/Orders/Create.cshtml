@page
@model wt_lab5_5razor_talko.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Создать заказ";
    Layout = "_Layout";
}

<div class="container py-4">
    <h1 style="color: #4a3d24;">Создать заказ</h1>
    <form method="post" class="mt-4 shadow p-4 rounded bg-light">

        <!-- Адрес -->
        <div class="mb-3">
            <label asp-for="Order.Address" class="form-label">Адрес доставки</label>
            <input asp-for="Order.Address" class="form-control" required />
            <span asp-validation-for="Order.Address" class="text-danger"></span>
        </div>

        <!-- ВЫБОР БЛЮДА -->
        <div class="mb-3">
            <label asp-for="Order.DishId" class="form-label">Выберите блюдо</label>
            <select asp-for="Order.DishId" asp-items="Model.Dishes" class="form-select">
                <option value="">-- Выберите блюдо --</option>
            </select>
            <span asp-validation-for="Order.DishId" class="text-danger"></span>
        </div>

        <!-- ВЫБОР КУРЬЕРА -->
        <div class="mb-3">
            <label asp-for="Order.CourierId" class="form-label">Назначить курьера</label>
            <select asp-for="Order.CourierId" asp-items="Model.Couriers" class="form-select">
                <option value="">-- Выберите курьера --</option>
            </select>
            <span asp-validation-for="Order.CourierId" class="text-danger"></span>
        </div>

        <!-- ВВОД СУММЫ -->
        <div class="mb-3">
            <label asp-for="Order.TotalPrice" class="form-label">Сумма заказа (руб.)</label>
            <input asp-for="Order.TotalPrice" class="form-control" type="number" step="0.01" required />
            <span asp-validation-for="Order.TotalPrice" class="text-danger"></span>
        </div>

        <!-- СТАТУС -->
        <div class="mb-3">
            <label asp-for="Order.Status" class="form-label">Статус</label>
            <input asp-for="Order.Status" class="form-control" value="В обработке" />
        </div>

        <button type="submit" class="btn btn-success">Создать</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>